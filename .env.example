# Gemini API Key (required for the default provider)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Atlas Cloud API Key (optional; used with --provider atlas)
# Get yours at: https://www.atlascloud.ai/console/api-keys
ATLASCLOUD_API_KEY=your_atlascloud_api_key_here
